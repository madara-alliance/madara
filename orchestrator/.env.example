#### AWS CONFIG ####
AWS_ACCESS_KEY_ID=                    # Your AWS access key ID
AWS_SECRET_ACCESS_KEY=                # Your AWS secret access key
AWS_REGION=                          # AWS region
# For AWS SDK
AWS_ENDPOINT_URL=                    # AWS endpoint URL
# For Omniqueue
AWS_DEFAULT_REGION=                  # AWS default region
MADARA_ORCHESTRATOR_AWS_PREFIX=      # Optional AWS resource name prefix

# For EventBridge
MADARA_ORCHESTRATOR_EVENT_BRIDGE_TYPE=       # EventBridge type (rule/schedule)
MADARA_ORCHESTRATOR_EVENT_BRIDGE_INTERVAL_SECONDS=        # EventBridge interval in seconds

#### ALERTS ####
MADARA_ORCHESTRATOR_AWS_SNS_TOPIC_IDENTIFIER=     # SNS topic ARN or name

#### DATA AVAILABILITY ####
## ETHEREUM ##
MADARA_ORCHESTRATOR_ETHEREUM_DA_RPC_URL=   # Ethereum RPC URL for data availability
## STARKNET ##
MADARA_ORCHESTRATOR_STARKNET_DA_RPC_URL=   # Starknet RPC URL for data availability

#### DATABASE ####
## MONGODB ##
MADARA_ORCHESTRATOR_MONGODB_CONNECTION_URL=   # MongoDB connection URL
MADARA_ORCHESTRATOR_DATABASE_NAME=            # MongoDB database name

#### PROVER ####
MADARA_ORCHESTRATOR_PROVER=                   # Prover backend: sharp, atlantic, or mock
## SHARP ##
MADARA_ORCHESTRATOR_SHARP_CUSTOMER_ID=        # SHARP customer ID
MADARA_ORCHESTRATOR_SHARP_URL=                # SHARP service URL
MADARA_ORCHESTRATOR_SHARP_USER_CRT_FILE=      # Path to SHARP user certificate PEM
MADARA_ORCHESTRATOR_SHARP_USER_KEY_FILE=      # Path to SHARP user private key PEM
MADARA_ORCHESTRATOR_SHARP_SERVER_CRT_FILE=    # Path to SHARP server certificate PEM
MADARA_ORCHESTRATOR_SHARP_RPC_NODE_URL=       # SHARP RPC node URL
MADARA_ORCHESTRATOR_SHARP_SETTLEMENT_LAYER=   # SHARP settlement layer (default: ethereum)
MADARA_ORCHESTRATOR_GPS_VERIFIER_CONTRACT_ADDRESS=   # GPS verifier contract address

## ATLANTIC ##
MADARA_ORCHESTRATOR_ATLANTIC_API_KEY=         # Atlantic API key
# Or mount the API key in a file:
# MADARA_ORCHESTRATOR_ATLANTIC_API_KEY_FILE=  # Path to Atlantic API key file
MADARA_ORCHESTRATOR_ATLANTIC_SERVICE_URL=     # Atlantic service URL
MADARA_ORCHESTRATOR_ATLANTIC_MOCK_FACT_HASH=  # Whether to use mock fact registry (true/false)
MADARA_ORCHESTRATOR_ATLANTIC_PROVER_TYPE=     # Atlantic prover type
MADARA_ORCHESTRATOR_ATLANTIC_SETTLEMENT_LAYER= # Settlement layer (ethereum/starknet)
MADARA_ORCHESTRATOR_ATLANTIC_VERIFIER_CONTRACT_ADDRESS=  # Atlantic verifier contract address
MADARA_ORCHESTRATOR_ATLANTIC_RPC_NODE_URL=    # Atlantic RPC node URL
MADARA_ORCHESTRATOR_ATLANTIC_NETWORK=         # MAINNET or TESTNET
MADARA_ORCHESTRATOR_ATLANTIC_CAIRO_VM=        # Cairo VM (default: rust)
MADARA_ORCHESTRATOR_ATLANTIC_RESULT=          # Atlantic result type (default: proof-generation)
MADARA_ORCHESTRATOR_ATLANTIC_SHARP_PROVER=    # Atlantic SHARP prover backend (default: stone)
MADARA_ORCHESTRATOR_ATLANTIC_ARTIFACTS_BASE_URL= # Atlantic artifacts base URL
MADARA_ORCHESTRATOR_CAIRO_V0_VERIFIER_PROGRAM_HASH= # Optional Cairo 0 verifier program hash

## MOCK ##
MADARA_ORCHESTRATOR_MOCK_VERIFIER_ADDRESS=    # Optional MockGpsVerifier address

#### SETTLEMENT ####
## ETHEREUM ##
MADARA_ORCHESTRATOR_ETHEREUM_SETTLEMENT_RPC_URL=  # Ethereum settlement RPC URL
MADARA_ORCHESTRATOR_ETHEREUM_PRIVATE_KEY=         # Ethereum private key
MADARA_ORCHESTRATOR_L1_CORE_CONTRACT_ADDRESS=     # L1 core contract address
MADARA_ORCHESTRATOR_STARKNET_OPERATOR_ADDRESS=    # Starknet operator address
MADARA_ORCHESTRATOR_ETHEREUM_FINALITY_RETRY_WAIT_IN_SECS= # Ethereum finality retry wait in seconds
MADARA_ORCHESTRATOR_EIP1559_MAX_GAS_MUL_FACTOR=   # Max gas price multiplier for retries
MADARA_ORCHESTRATOR_ETHEREUM_DISABLE_PEERDAS=     # Disable PeerDAS for Ethereum settlement

## STARKNET ##
MADARA_ORCHESTRATOR_STARKNET_SETTLEMENT_RPC_URL=  # Starknet settlement RPC URL
MADARA_ORCHESTRATOR_STARKNET_PRIVATE_KEY=         # Starknet private key
MADARA_ORCHESTRATOR_STARKNET_ACCOUNT_ADDRESS=     # Starknet account address
MADARA_ORCHESTRATOR_STARKNET_CAIRO_CORE_CONTRACT_ADDRESS=  # Starknet Cairo core contract address
MADARA_ORCHESTRATOR_STARKNET_FINALITY_RETRY_WAIT_IN_SECS=  # Retry wait time in seconds

#### STORAGE ####
## AWS S3 ##
MADARA_ORCHESTRATOR_AWS_S3_BUCKET_IDENTIFIER=      # S3 bucket ARN or name
MADARA_ORCHESTRATOR_STORAGE_EXPIRATION_DAYS=        # Days before S3 expiration cleanup

#### QUEUE ####
MADARA_ORCHESTRATOR_AWS_SQS_QUEUE_IDENTIFIER=       # SQS queue ARN or template name

#### INSTRUMENTATION ####
## OTEL ##
MADARA_ORCHESTRATOR_OTEL_SERVICE_NAME=       # OpenTelemetry service name
MADARA_ORCHESTRATOR_OTEL_COLLECTOR_ENDPOINT= # OpenTelemetry collector endpoint

#### SERVER ####
MADARA_ORCHESTRATOR_HOST=                    # Server host
MADARA_ORCHESTRATOR_PORT=                    # Server port
MADARA_ORCHESTRATOR_ADMIN_ENABLED=           # Enable admin routes

#### SERVICE ####
MADARA_ORCHESTRATOR_MAX_BLOCK_NO_TO_PROCESS=  # Maximum block number to process (optional)
MADARA_ORCHESTRATOR_MIN_BLOCK_NO_TO_PROCESS=  # Minimum block number to process (optional)
MADARA_ORCHESTRATOR_MADARA_RPC_URL=           # Madara RPC URL
MADARA_ORCHESTRATOR_MADARA_FEEDER_GATEWAY_URL= # Optional Madara feeder gateway URL
MADARA_ORCHESTRATOR_REPLAY_BOUNDS_RPC_URL=    # Optional reference node RPC URL for replay bounds
MADARA_ORCHESTRATOR_BOUNCER_WEIGHTS_LIMIT_FILE= # Optional bouncer weights limit file path
MADARA_ORCHESTRATOR_LAYER=                    # l2 or l3
MADARA_ORCHESTRATOR_DA_PUBLIC_KEYS=           # Optional comma-separated DA public keys
MADARA_ORCHESTRATOR_MAX_CONCURRENT_CREATED_SNOS_JOBS= # Max created SNOS jobs to maintain
MADARA_ORCHESTRATOR_MAX_CONCURRENT_SNOS_JOBS= # Max SNOS jobs processed concurrently
MADARA_ORCHESTRATOR_MAX_CONCURRENT_PROVING_JOBS= # Max proving jobs processed concurrently
MADARA_ORCHESTRATOR_MAX_CONCURRENT_AGGREGATOR_JOBS= # Max aggregator jobs processed concurrently
MADARA_ORCHESTRATOR_SNOS_JOB_TIMEOUT_SECONDS= # Locked SNOS job timeout
MADARA_ORCHESTRATOR_PROVING_JOB_TIMEOUT_SECONDS= # Locked proving job timeout
MADARA_ORCHESTRATOR_PROOF_REGISTRATION_TIMEOUT_SECONDS= # Locked proof registration timeout
MADARA_ORCHESTRATOR_DATA_SUBMISSION_TIMEOUT_SECONDS= # Locked data submission timeout
MADARA_ORCHESTRATOR_STATE_TRANSITION_TIMEOUT_SECONDS= # Locked state transition timeout
MADARA_ORCHESTRATOR_AGGREGATOR_JOB_TIMEOUT_SECONDS= # Locked aggregator job timeout
MADARA_ORCHESTRATOR_SNOS_JOB_BUFFER_SIZE=      # Target SNOS job buffer size
MADARA_ORCHESTRATOR_AGGREGATOR_JOB_BUFFER_SIZE= # Target aggregator job buffer size
MADARA_ORCHESTRATOR_MAX_PRIORITY_QUEUE_SIZE=   # Max priority queue size
MADARA_ORCHESTRATOR_STORE_AUDIT_ARTIFACTS=     # Store generated audit artifacts

#### SNOS ####
MADARA_ORCHESTRATOR_RPC_FOR_SNOS=             # SNOS RPC URL
MADARA_ORCHESTRATOR_RPC_FOR_SNOS_BACKUP=      # Backup SNOS RPC URL used for retried jobs
MADARA_ORCHESTRATOR_SNOS_FULL_OUTPUT=         # Whether to use full SNOS output
MADARA_ORCHESTRATOR_VERSIONED_CONSTANTS_PATH= # Optional versioned constants JSON path
MADARA_ORCHESTRATOR_SNOS_LAYOUT_NAME=         # SNOS layout name
MADARA_ORCHESTRATOR_PROVER_LAYOUT_NAME=       # Prover layout name

#### BATCHING ####
MADARA_ORCHESTRATOR_MAX_BATCH_TIME_SECONDS=   # Maximum batch time in seconds
MADARA_ORCHESTRATOR_MAX_BATCH_SIZE=           # Maximum batch size
MADARA_ORCHESTRATOR_MAX_NUM_BLOBS=            # Maximum blobs per state update
MADARA_ORCHESTRATOR_BLOB_SIZE_BUFFER=         # Blob capacity buffer in felts
MADARA_ORCHESTRATOR_BATCHING_LOCK_DURATION_SECONDS= # Batching worker lock duration in seconds
MADARA_ORCHESTRATOR_MAX_BLOCKS_PER_SNOS_BATCH= # Max blocks in one SNOS batch
MADARA_ORCHESTRATOR_FIXED_BLOCKS_PER_SNOS_BATCH= # Optional fixed blocks per SNOS batch
MADARA_ORCHESTRATOR_MAX_SNOS_BATCHES_PER_AGGREGATOR_BATCH= # Max SNOS batches per aggregator batch
MADARA_ORCHESTRATOR_DEFAULT_EMPTY_BLOCK_PROVING_GAS= # Default proving gas for empty blocks
MADARA_ORCHESTRATOR_MAX_BATCH_PROCESSING_SIZE= # Max blocks processed in one batching pass

#### GRACEFUL SHUTDOWN ####
MADARA_ORCHESTRATOR_GRACEFUL_SHUTDOWN_TIMEOUT=   # Time(s) allowed for which orchestrator tries graceful shutdown

#### SETUP COMMAND ####
MADARA_ORCHESTRATOR_SETUP_TIMEOUT=           # Setup timeout in seconds
MADARA_ORCHESTRATOR_SETUP_RESOURCE_POLL_INTERVAL= # Setup resource polling interval in seconds
